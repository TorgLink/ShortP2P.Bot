<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ShortP2P.Bot.Sample.Meteo</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="NLog" Version="5.3.4" />
    <PackageReference Include="NLog.Extensions.Logging" Version="5.3.11" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ShortP2P.Bot\ShortP2P.Bot.csproj" />
    <ProjectReference Include="..\ShortP2P.Bot.Sample.Shared\ShortP2P.Bot.Sample.Shared.csproj" />
    <ProjectReference Include="..\ShortP2P.Bot.Sample.Meteo.Shared\ShortP2P.Bot.Sample.Meteo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="..\ShortP2P.Bot.Sample\Echo\BotMessageCrypto.cs" Link="Shared\BotMessageCrypto.cs" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="ShortP2P.Bot.Sample.Meteo.Tests" />
  </ItemGroup>

  <ItemGroup>
    <None Update="bot_commands">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
