<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ShortP2P.Samples.Botticelli.Meteo</RootNamespace>
    <NoWarn>$(NoWarn);CA1416</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="NLog" Version="6.0.5" />
    <PackageReference Include="NLog.Extensions.Logging" Version="6.0.5" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\ShortP2P.Bot\ShortP2P.Bot.csproj" />
    <ProjectReference Include="..\..\Botticelli.Framework.ShortP2P\Botticelli.Framework.ShortP2P.csproj" />
    <ProjectReference Include="..\ShortP2P.Bot.Sample.Shared\ShortP2P.Bot.Sample.Shared.csproj" />
    <ProjectReference Include="..\ShortP2P.Bot.Sample.Meteo.Shared\ShortP2P.Bot.Sample.Meteo.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\ShortP2P.Bot.Sample.Meteo\nlog.config" Link="nlog.config">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="bot_commands">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>

</Project>
